; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Krits"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false

[autoload]

Events="*res://core/events.gd"
InputSetup="*res://core/input_setup.gd"
Game="*res://core/game.gd"
Music="*res://core/music_player.gd"
Settings="*res://core/settings.gd"
ShaderClock="*res://core/shader_clock.gd"
Iris="*res://ui/loading_screen.tscn"
CyclopsAutoload="*uid://4siqre3jhe80"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/cyclops_level_builder/plugin.cfg", "res://addons/proton_scatter/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom_font="res://assets/fonts/zyzol/Zyzol.otf"

[layer_names]

3d_render/layer_2="character_outline"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="bullet"
3d_physics/layer_5="orb"
3d_physics/layer_6="trigger"
3d_physics/layer_8="camera_push"

[physics]

common/physics_ticks_per_second=120

[rendering]

environment/volumetric_fog/volume_size=32
environment/volumetric_fog/volume_depth=32
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[shader_globals]

time_offset={
"type": "float",
"value": 0.0
}
level_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
level_tint_amount={
"type": "float",
"value": 0.0
}
