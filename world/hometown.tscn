[sub_resource type="Resource" id="Node_MiraBye"]
script = ExtResource("1_dnode")
speaker = "Elder Mira"
text = "Take care out there."

[sub_resource type="Resource" id="Node_MiraInfo"]
script = ExtResource("1_dnode")
speaker = "Elder Mira"
text = "This little place has been here longer than I have, believe it or not. Quiet, mostly. We like it that way."
next = SubResource("Node_MiraBye")

[sub_resource type="Resource" id="Choice_MiraInfo"]
script = ExtResource("1_dchoice")
text = "Tell me about this town"
next = SubResource("Node_MiraInfo")

[sub_resource type="Resource" id="Choice_MiraBye"]
script = ExtResource("1_dchoice")
text = "Just passing through"
next = SubResource("Node_MiraBye")

[sub_resource type="Resource" id="Node_MiraGreet"]
script = ExtResource("1_dnode")
speaker = "Elder Mira"
text = "Oh, hello there! Passing through, or just taking in the sights?"
sets_flag = &"met_mira"
choices = [SubResource("Choice_MiraInfo"), SubResource("Choice_MiraBye")]

