[resource]
script = ExtResource("s")
speaker = "Mayor Arse"
text = "Ah, a traveler with strong legs and no plans. Perfect. The desert town far beyond the plains is dying of thirst. Their wells ran dry years ago. Would you carry a message and a favor for me?"
choices = Array[ExtResource("cs")]([ExtResource("c0"), ExtResource("c1"), ExtResource("c2")])
