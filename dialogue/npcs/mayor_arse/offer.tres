[ext_resource type="Script" path="res://dialogue/dialogue_choice.gd" id="cs"]
[ext_resource type="Resource" path="res://dialogue/npcs/mayor_arse/c_accept.tres" id="c0"]
[ext_resource type="Resource" path="res://dialogue/npcs/mayor_arse/c_info.tres" id="c1"]
