[gd_resource type="Resource" script_class="DialogueNode" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_node.gd" id="s"]

[resource]
script = ExtResource("s")
speaker = "Mayor Arse"
text = "Still here? The water spirits sleep at the bottom of the well. Jump into the hollow and keep going down. After that, the road east to the desert town."
